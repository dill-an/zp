# Path to the SQLite database file (created on first migrate)
DATABASE_PATH=./data/zp.db
# Secret used to sign session cookies; set a long random string in production.
# It also signs the per-member calendar subscription links (/api/calendar/<token>):
# changing it invalidates every link brothers have already added to their calendar apps.
SESSION_SECRET=change-me-in-production
# Default password assigned to seeded members (they must change it on first login)
SEED_DEFAULT_PASSWORD=zetapsi
